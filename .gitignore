# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Patterns are deliberately UNANCHORED (no leading slash) so they match inside
# both workspaces — frontend/node_modules and backend/dist alike. A leading
# slash would pin them to the repo root and silently miss everything below it.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js — frontend
.next/
out/

# nest — backend
dist/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is committed, real ones never are
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local storage driver's files — never committed
backend/.storage/
.claude/
claude_config.json
claude-env/
*.claude