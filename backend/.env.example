# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Local Postgres. Create the database first:
#   createdb stayora
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stayora

# The suite's own database — REQUIRED when NODE_ENV=test.
#
# The specs TRUNCATE between files. Pointed at the database `npm run dev` is
# also serving, a test run wipes the seeded catalogue out from under a browser
# and a live request can land mid-truncate. Create it once:
#
#   docker exec stayora-db psql -U postgres -c "CREATE DATABASE stayora_test;"
#   npm run db:migrate:test
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/stayora_test

# Signs the session cookie. Generate a fresh one:
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-at-least-32-characters-long-secret

# The Next app's origin. Only used for direct (non-proxied) browser calls.
WEB_ORIGIN=http://localhost:3000

# Leave unset on localhost. In production: .stayora.com
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------- mail
# `fake` keeps every message in memory and sends nothing — which is what you
# want locally and in tests. Switching to `sendgrid` WITHOUT a key now refuses
# to boot rather than failing each email silently.
MAIL_DRIVER=fake

# From https://app.sendgrid.com/settings/api_keys — "Restricted Access" with
# only "Mail Send" enabled is enough. Required when MAIL_DRIVER=sendgrid.
# SENDGRID_API_KEY=

# The sender. The domain must be verified in SendGrid first
# (Settings → Sender Authentication), or every message is rejected.
MAIL_FROM=no-reply@stayora.com
MAIL_FROM_NAME=Stayora

# ------------------------------------------------------------------- storage
# `fake` writes photos to disk and serves them from this API. `s3` needs the
# three credentials below, and refuses to boot without them.
STORAGE_DRIVER=fake
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_BUCKET=stayora-photos
STORAGE_PUBLIC_URL=http://localhost:4000/api/v1/files
