# Stayora API — production/staging on a shared VPS.
#
#   cp deploy/backend.env.example backend/.env
#
# Then replace every <ANGLE BRACKET>. The process refuses to boot on a bad
# value rather than failing later, so a mistake here surfaces immediately.

NODE_ENV=production

# ------------------------------------------------------------------ network

PORT=4020

# 127.0.0.1, not 0.0.0.0 — and this one matters.
#
# `trust proxy` is 1, so the API BELIEVES the X-Forwarded-For it is handed.
# That is correct when nginx is the only thing that can reach it. Leave the
# port open to the internet and any caller can set that header themselves, be
# a different client on every request, and the rate limiter counts nothing.
HOST=127.0.0.1

# The PUBLIC address of the site — the one a person types.
#
# Not only CORS. Every verification link, every password-reset link and the
# payment return URL is built from this. Wrong here means emails whose links
# lead nowhere.
WEB_ORIGIN=http://169.58.197.190:8080

# ----------------------------------------------------------------- database

# Its own role and its own database on the shared Postgres, so a leak in one
# project cannot read another's tables.
DATABASE_URL=postgres://stayora:<DB-PASSWORD>@127.0.0.1:5432/stayora

# ------------------------------------------------------------------ session

# 48 bytes of real randomness:  openssl rand -base64 48
# The development value literally says "replace before any deploy" in its own
# text. Sessions are signed with this; changing it later signs everyone out.
SESSION_SECRET=<PASTE-openssl-rand-base64-48>

# Whether the session cookie may only travel over TLS.
#
# `false` ONLY because this host has no certificate yet. On plain HTTP a
# `Secure` cookie is set by the server and silently discarded by the browser:
# login answers 200 and every request after it answers 401, with nothing in
# any log to explain it.
#
# The API logs a warning on every boot for as long as this is false.
# DELETE THIS LINE the day there is a domain and a certificate — it then
# defaults back to on by itself.
COOKIE_SECURE=false

# Leave unset while there is no domain. With one, and the app on a subdomain,
# set it to the registrable domain with a leading dot: .example.com
# COOKIE_DOMAIN=

# --------------------------------------------------------------------- mail

# `fake` accepts every message and delivers none — the honest setting until a
# provider is configured. `GET /api/v1/admin/notifications/health` answers
# `not_sending` while this is fake, and the admin dashboard shows it, so
# nobody has to guess whether email is working.
MAIL_DRIVER=fake

# Required when MAIL_DRIVER=sendgrid. The sending DOMAIN must be verified in
# SendGrid first, or every message is rejected.
# SENDGRID_API_KEY=

MAIL_FROM=no-reply@<YOUR-DOMAIN>
MAIL_FROM_NAME=Stayora

# ------------------------------------------------------------------ storage

# `fake` writes uploads to backend/.storage/ on THIS machine and serves them
# back through the API. Fine for a test box, with two caveats worth knowing
# before somebody uploads something they care about:
#   · a redeploy that replaces the directory loses every photo;
#   · a second instance cannot see the first one's files.
STORAGE_DRIVER=fake

# For real storage, switch to s3 and fill these three — the process refuses to
# boot without them, rather than failing on the first upload.
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_BUCKET=stayora-photos
STORAGE_PUBLIC_URL=http://169.58.197.190:8080/api/v1/files

# --------------------------------------------------------------------- test

# Not needed in production. It is REQUIRED when NODE_ENV=test, because the
# suite TRUNCATEs between files and must never be pointed at a database
# anything else is using.
# TEST_DATABASE_URL=
