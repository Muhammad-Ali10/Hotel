# Stayora web — production build.
#
#   cp deploy/frontend.env.example frontend/.env.production
#
# ONE variable, and it is the one that catches people out.

# The API, as the BROWSER will address it — not as the server sees it.
#
# `/api/v1` on the same host and port as the site itself, because nginx serves
# both from one port. Same origin means no CORS and no cross-site cookie.
#
# FROZEN AT BUILD TIME. Next replaces this expression with a literal string
# while building, so editing this file and restarting changes nothing at all —
# the old address is compiled into the bundle. Get it right, THEN run
# `npm run build`. If it is already wrong, rebuild; do not debug the server.
NEXT_PUBLIC_API_URL=http://169.58.197.190:8080/api/v1
